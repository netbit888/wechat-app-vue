<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain> <!-- 模拟器本地服务器 -->
        <domain includeSubdomains="true">YOUR_SERVER_IP</domain> <!-- 你的服务器IP -->
        <domain includeSubdomains="true">YOUR_SERVER_DOMAIN</domain> <!-- 你的服务器域名 -->
    </domain-config>
</network-security-config>